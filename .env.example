# Copy to .env and fill in. .env is gitignored.

# --- Anthropic (the AI coach) ---
# The API key itself is NOT stored here — it's encrypted at rest.
# Run: python -m scripts.set_secrets
ANTHROPIC_MODEL=claude-sonnet-5

# --- Firebase (backend admin SDK) ---
# Absolute path to your service-account JSON. Keep it OUTSIDE this repo.
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_CREDENTIALS_PATH=/Users/you/.garmin-trainer-dashboard/keys/firebase-credentials.json

# Your Google account email. Only this account may sign in.
# Leave empty to accept any signed-in Google account (local use only).
ALLOWED_EMAIL=you@example.com

# --- Garmin MCP server ---
# Credentials are encrypted at rest — run: python -m scripts.set_secrets
GARMIN_MCP_COMMAND=npx
GARMIN_MCP_ARGS=-y @nicolasvegam/garmin-connect-mcp

# --- Your goal ---
# Target watts is computed dynamically as TARGET_WKG x your current weight.
TARGET_WKG=4.0

# --- intervals.icu (optional; powers the Fitness/Fatigue/Form chart) ---
# Your athlete ID, from your intervals.icu profile URL (e.g. .../athlete/i123456).
# The API key is encrypted at rest — run: python -m scripts.set_secrets
INTERVALS_ATHLETE_ID=
